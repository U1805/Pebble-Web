# Pebble Web service
# Copy the values you need into your process environment or deployment config.

# Required. The service refuses known placeholder/default values.
PEBBLE_PASSWORD=changeme
PEBBLE_JWT_SECRET=change-this-to-a-random-string

# Optional service settings.
PEBBLE_PORT=8080
PEBBLE_DATA_DIR=./data
PEBBLE_SYNC_INTERVAL=300
PEBBLE_STATIC_DIR=./dist

# Optional. 64 hex characters. If omitted, Pebble Web creates data/encryption.key.
# PEBBLE_ENCRYPTION_KEY=

# Required when Gmail or Outlook OAuth is used.
PEBBLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/oauth/callback

# OAuth provider credentials.
# These use the same variable names as the upstream desktop application.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
