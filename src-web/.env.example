# Pebble Web service
# Copy the values you need into your process environment or deployment config.

# Required. The service refuses known placeholder/default values.
PEBBLE_PASSWORD=changeme
PEBBLE_JWT_SECRET=change-this-to-a-random-string

# Optional service settings.
PEBBLE_PORT=8080
PEBBLE_DATA_DIR=./data
PEBBLE_SYNC_INTERVAL=300
PEBBLE_STATIC_DIR=./dist

# Optional. 64 hex characters. If omitted, Pebble Web creates data/encryption.key.
# PEBBLE_ENCRYPTION_KEY=

# Optional. Only required when Gmail or Outlook OAuth is used. The value must
# be the URL that the browser can return to, including /api/v1/oauth/callback.
# PEBBLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/oauth/callback

# OAuth provider credentials.
# These use the same variable names as the upstream desktop application.

# Gmail setup:
# 1. Create or select a Google Cloud project and enable the Gmail API.
# 2. Configure the OAuth consent screen. While the app is in Testing status,
#    add every Gmail account that will authorize Pebble Web as a test user.
# 3. Create an OAuth 2.0 client of type "Web application".
# 4. Add the exact PEBBLE_OAUTH_REDIRECT_URL above as an authorized redirect
#    URI. For deployment, use the final HTTPS origin instead of localhost.
# 5. Copy the client ID and client secret below, then restart Pebble Web.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Outlook setup.
# MICROSOFT_CLIENT_ID=your-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
